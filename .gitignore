# 构建产物
/dist/
/build/
*.egg-info/
*.whl
*.tar.gz

# makepkg 的工作目录与产物
/packaging/src/
/packaging/pkg/
/packaging/*.pkg.tar.*

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/

