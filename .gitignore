*.bak.*
*.backup[0-9]*

# 自检/调试的临时产物
/preview/
/_chk/
/_d/
/_disttest/
/_pkgtest/
/_xdgtest/
/_v.log
/_st.log

# 编译出的验证器（源码 verify_cursor.c 保留）
/verify_cursor
