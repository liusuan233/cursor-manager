# 构建产物
/dist/
/build/
*.egg-info/
*.whl
*.tar.gz

# makepkg 的工作目录与产物
/packaging/src/
/packaging/pkg/
/packaging/*.pkg.tar.*

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/

# 编辑器 / 系统
*.swp
*~
.DS_Store
.idea/
.vscode/

# 本项目运行时产生的备份（apply.py / set-cursor.sh 会写 .bak.<时间戳>）
*.bak.*
*.backup[0-9]*

# 自检/调试的临时产物
/preview/
/_chk/
/_d/
/_disttest/
/_pkgtest/
/_xdgtest/
/_v.log
/_st.log

# 编译出的验证器（源码 verify_cursor.c 保留）
/verify_cursor
# 我处理用户素材时用的临时解压目录（第三方版权内容，绝不入库）
/_miku/
/_tmp*/
/_extract/

# 演示视频是生成的构建产物（几十 MB，不适合进仓库）
/demo/*.mp4
/demo/*.gif
/demo/stills/

# 图标预览图是调试用的
/icons/_preview.png
